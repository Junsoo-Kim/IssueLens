# 비밀정보
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 수집 원본과 생성 데이터 (디렉터리 구조만 유지)
data/raw/**
data/cache/**
data/processed/**
chroma_db/**
sparse_index/**
!**/.gitkeep

# 이슈 원문이 담긴 수집 결과(*.jsonl)는 공개 저장소에 올리지 않고 로컬에만 둔다.
# 원문이 없는 수집 통계만 커밋한다.
!data/processed/collection_stats.json

# 수집 재개용 상태는 로컬에만 둔다 (source_manifest.json, 선택 파일은 커밋)
data/manifests/*_manifest.jsonl

# 기타
.DS_Store
.idea/
.vscode/
